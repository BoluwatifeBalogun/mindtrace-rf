# Copy to .env or set these in your shell / hosting dashboard.
# MySQL (XAMPP, WAMP or a hosted server). Leave unset to use the built-in SQLite file.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/mindtrace_ng
SECRET_KEY=change-me-to-a-long-random-string
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
